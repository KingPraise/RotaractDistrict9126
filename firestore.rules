rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // RBAC & AUTH HELPER FUNCTIONS
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isDistrictAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role == 'district_admin') ||
        (userDocExists() && getUserData().role == 'district_admin')
      );
    }

    function isPresident() {
      return isAuthenticated() && (
        (request.auth.token.role == 'president' || request.auth.token.role == 'club_president') ||
        (userDocExists() && (getUserData().role == 'president' || getUserData().role == 'club_president'))
      );
    }

    function isClubPresident(clubId) {
      return isAuthenticated() && (
        ((request.auth.token.role == 'president' || request.auth.token.role == 'club_president') && request.auth.token.clubId == clubId) ||
        (userDocExists() && (getUserData().role == 'president' || getUserData().role == 'club_president') && getUserData().clubId == clubId)
      );
    }

    // ============================================================
    // 1. USERS COLLECTION (`users/{userId}`)
    // ============================================================
    match /users/{userId} {
      // Authenticated users can view member profiles
      allow read: if isAuthenticated();

      // Users can create their own account document upon initial sign-up
      allow create: if isOwner(userId) || isDistrictAdmin();

      // Members can update their personal profile info (name, phone, occupation, avatar)
      // Only District Admins or Club Presidents can alter duesStatus, role, or clubId
      allow update: if isAuthenticated() && (
        isDistrictAdmin() ||
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'duesStatus', 'rotaryId', 'clubId'])
        ) ||
        (
          isClubPresident(resource.data.clubId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rotaryId', 'clubId'])
        )
      );

      // Only District Admins can remove user accounts
      allow delete: if isDistrictAdmin();
    }

    // ============================================================
    // 2. CLUBS COLLECTION (`clubs/{clubId}`)
    // ============================================================
    match /clubs/{clubId} {
      // Public directory & map finder access
      allow read: if true;

      // Only District Admins can create or delete clubs
      allow create, delete: if isDistrictAdmin();

      // District Admins or assigned Club Presidents can update club details
      allow update: if isDistrictAdmin() || isClubPresident(clubId);
    }

    // ============================================================
    // 3. PROJECTS COLLECTION (`projects/{projectId}`)
    // ============================================================
    match /projects/{projectId} {
      // Public community impact archive
      allow read: if true;

      // Club Presidents & District Admins can publish projects
      allow create: if isAuthenticated() && (
        isDistrictAdmin() ||
        isClubPresident(request.resource.data.clubId)
      );

      // District Admins or Club Presidents for the owning club can update projects
      allow update: if isAuthenticated() && (
        isDistrictAdmin() ||
        isClubPresident(resource.data.clubId)
      );

      // District Admins or Club Presidents can delete projects
      allow delete: if isAuthenticated() && (
        isDistrictAdmin() ||
        isClubPresident(resource.data.clubId)
      );
    }

    // ============================================================
    // 4. ARTICLES COLLECTION (`articles/{articleId}`)
    // ============================================================
    match /articles/{articleId} {
      // Public reading for blog & news articles
      allow read: if true;

      // Only District Admins can create, update, or delete articles
      allow write: if isDistrictAdmin();
    }

    // ============================================================
    // 5. EVENTS COLLECTION (`events/{eventId}`)
    // ============================================================
    match /events/{eventId} {
      // Public reading for district & club events
      allow read: if true;

      // District Admins and Club Presidents can manage events
      allow write: if isDistrictAdmin() || isPresident();
    }

    // ============================================================
    // 6. EVENT REGISTRATIONS (`event_registrations/{registrationId}`)
    // ============================================================
    match /event_registrations/{registrationId} {
      // Authenticated users can view their own registrations;
      // Admins and Club Presidents can inspect event attendees
      allow read: if isAuthenticated() && (
        isDistrictAdmin() ||
        (resource.data.userId != null && isOwner(resource.data.userId)) ||
        (resource.data.memberId != null && isOwner(resource.data.memberId)) ||
        (resource.data.email != null && request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
        (resource.data.clubId != null && isClubPresident(resource.data.clubId))
      );

      // Members can register themselves; Admins & Presidents can register attendees
      allow create: if isAuthenticated() && (
        isDistrictAdmin() ||
        (
          (request.resource.data.userId != null && isOwner(request.resource.data.userId)) ||
          (request.resource.data.memberId != null && isOwner(request.resource.data.memberId)) ||
          (!('userId' in request.resource.data) && !('memberId' in request.resource.data) &&
           request.resource.data.email != null && request.auth.token.email != null &&
           request.resource.data.email == request.auth.token.email)
        ) ||
        (request.resource.data.clubId != null && isClubPresident(request.resource.data.clubId))
      ) && (
        // Field validation: eventId must be a non-empty string
        request.resource.data.eventId is string &&
        request.resource.data.eventId.size() > 0
      );

      // Registrants can update their details (cannot alter ownership or target eventId)
      allow update: if isAuthenticated() && (
        isDistrictAdmin() ||
        (
          (
            (resource.data.userId != null && isOwner(resource.data.userId)) ||
            (resource.data.memberId != null && isOwner(resource.data.memberId))
          ) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'memberId', 'eventId'])
        ) ||
        (
          resource.data.clubId != null &&
          isClubPresident(resource.data.clubId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'memberId', 'eventId'])
        )
      );

      // Registrants can cancel their RSVP; Admins & Presidents can delete entries
      allow delete: if isAuthenticated() && (
        isDistrictAdmin() ||
        (resource.data.userId != null && isOwner(resource.data.userId)) ||
        (resource.data.memberId != null && isOwner(resource.data.memberId)) ||
        (resource.data.clubId != null && isClubPresident(resource.data.clubId))
      );
    }

    // ============================================================
    // 7. EVENT ATTENDANCES (`event_attendances/{attendanceId}`)
    // ============================================================
    match /event_attendances/{attendanceId} {
      // Members can inspect their own verified attendance & volunteer hours;
      // Admins and Club Presidents can audit club attendance
      allow read: if isAuthenticated() && (
        isDistrictAdmin() ||
        (resource.data.memberId != null && isOwner(resource.data.memberId)) ||
        (resource.data.userId != null && isOwner(resource.data.userId)) ||
        (resource.data.clubId != null && isClubPresident(resource.data.clubId))
      );

      // Only District Admins and Club Presidents can log attendance / roll-call entries
      allow create: if isAuthenticated() && (
        isDistrictAdmin() ||
        (request.resource.data.clubId != null && isClubPresident(request.resource.data.clubId)) ||
        (!('clubId' in request.resource.data) && isPresident())
      ) && (
        // Validation: eventId and member identifier required
        request.resource.data.eventId is string &&
        request.resource.data.eventId.size() > 0 &&
        (
          (request.resource.data.memberId is string && request.resource.data.memberId.size() > 0) ||
          (request.resource.data.userId is string && request.resource.data.userId.size() > 0)
        )
      );

      // Only District Admins and Club Presidents can modify attendance records
      allow update: if isAuthenticated() && (
        isDistrictAdmin() ||
        (resource.data.clubId != null && isClubPresident(resource.data.clubId))
      );

      // Only District Admins and Club Presidents can delete attendance records
      allow delete: if isAuthenticated() && (
        isDistrictAdmin() ||
        (resource.data.clubId != null && isClubPresident(resource.data.clubId))
      );
    }

    // ============================================================
    // 8. PROSPECT LEADS & PROSPECTS COLLECTIONS
    // ============================================================
    match /prospect_leads/{leadId} {
      // Public prospective member lead intake capture
      allow create: if true;

      // Only District Admins or assigned Club Presidents can read and update leads
      allow read: if isAuthenticated() && (
        isDistrictAdmin() ||
        isClubPresident(resource.data.assignedClubId) ||
        (resource.data.assignedClub != null && isClubPresident(resource.data.assignedClub))
      );

      allow update: if isAuthenticated() && (
        isDistrictAdmin() ||
        isClubPresident(resource.data.assignedClubId) ||
        (resource.data.assignedClub != null && isClubPresident(resource.data.assignedClub))
      );

      allow delete: if isDistrictAdmin();
    }

    match /prospects/{prospectId} {
      // Public prospective member intake submission
      allow create: if true;

      // Only District Admins or assigned Club Presidents can read and manage pipeline
      allow read: if isAuthenticated() && (
        isDistrictAdmin() ||
        isClubPresident(resource.data.assignedClubId) ||
        (resource.data.assignedClub != null && isClubPresident(resource.data.assignedClub))
      );

      allow update: if isAuthenticated() && (
        isDistrictAdmin() ||
        isClubPresident(resource.data.assignedClubId) ||
        (resource.data.assignedClub != null && isClubPresident(resource.data.assignedClub))
      );

      allow delete: if isDistrictAdmin();
    }

    // ============================================================
    // 9. HISTORICAL LEADERSHIP ARCHIVE (`leadership/{eraId}`)
    // ============================================================
    match /leadership/{eraId} {
      // Public heritage & leadership lineage archive
      allow read: if true;

      // Only District Admins can modify leadership records
      allow write: if isDistrictAdmin();
    }

    // ============================================================
    // 10. DUES PAYMENTS LEDGER (`dues_payments/{paymentId}`)
    // ============================================================
    match /dues_payments/{paymentId} {
      // Members can read their own payments; Club Presidents & District Admins can read club payments
      allow read: if isAuthenticated() && (
        isDistrictAdmin() ||
        isOwner(resource.data.userId) ||
        isOwner(resource.data.memberId) ||
        isClubPresident(resource.data.clubId)
      );

      // Members can submit payments; Admins/Presidents can record payments
      allow create: if isAuthenticated() && (
        isDistrictAdmin() ||
        isOwner(request.resource.data.userId) ||
        isOwner(request.resource.data.memberId) ||
        isClubPresident(request.resource.data.clubId)
      );

      allow update: if isDistrictAdmin() || isClubPresident(resource.data.clubId);
      allow delete: if isDistrictAdmin();
    }

    // ============================================================
    // 11. DUES AUDIT LOG (`dues_audit_log/{logId}`) — IMMUTABLE
    // ============================================================
    match /dues_audit_log/{logId} {
      // District Admins and Club Presidents can inspect audit logs
      allow read: if isAuthenticated() && (
        isDistrictAdmin() ||
        isClubPresident(resource.data.clubId)
      );

      // Only authenticated Admins and Club Presidents can append audit entries
      allow create: if isAuthenticated() && (
        isDistrictAdmin() ||
        isPresident()
      );

      // STRICT IMMUTABILITY: Updates and Deletions are permanently prohibited
      allow update, delete: if false;
    }

    // ============================================================
    // 12. NEWSLETTER SUBSCRIBERS (`subscribers/{subscriberId}`)
    // ============================================================
    match /subscribers/{subscriberId} {
      // Single doc lookup for duplicate checking; list query restricted to Admins
      allow get: if true;
      allow list: if isDistrictAdmin();

      // Public visitors can subscribe
      allow create: if true;

      // Only District Admins can manage subscriber list
      allow update, delete: if isDistrictAdmin();
    }

    // ============================================================
    // 13. DISTRICT METRICS (`metrics/{metricId}`)
    // ============================================================
    match /metrics/{metricId} {
      // Public statistics counter
      allow read: if true;

      // Only District Admins can update metrics
      allow write: if isDistrictAdmin();
    }

    // ============================================================
    // 14. AUTH USERS SYNC CACHE (`auth_users/{userId}`)
    // ============================================================
    match /auth_users/{userId} {
      allow read, write: if isAuthenticated() && (
        isOwner(userId) ||
        isDistrictAdmin()
      );
    }

    // ============================================================
    // 15. DEFAULT DENY CATCH-ALL
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
